{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.crt6.train.door": {
      "initial_state": "closed",
      "states": {
        "closed": {
          "transitions": [
            {
              "opening": "query.mod.is_door_open"
            }
          ]
        },
        "opening": {
          "transitions": [
            {
              "closed": "!query.mod.is_door_open"
            }
          ]
        }
      }
    },
    "controller.animation.crt6.train.move": {
      "initial_state": "default",
      "states": {
        "default": {}
      }
    }
  }
}