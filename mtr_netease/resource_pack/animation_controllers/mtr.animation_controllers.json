    "controller.animation.mtr.psd_door": {
      "initial_state": "closed",
      "states": {
        "closed": {
          "transitions": [
            {
              "opening": "query.mod.door_open"
            }
          ]
        },
        "opening": {
          "animations": [
            "open"
          ],
          "transitions": [
            {
              "closed": "!query.mod.door_open"
            }
          ]
        }
      }
    }
  }
